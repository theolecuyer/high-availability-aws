# Copy to .env next to docker-compose.prod.yml (on EC2, generate it in user data).
# Never commit the real .env.

# --- Images (non-secret) ---
# e.g. 123456789012.dkr.ecr.us-east-1.amazonaws.com
ECR_REGISTRY=
# e.g. v1.0.0 (prefer an immutable tag over "latest" so every instance runs the same build)
IMAGE_TAG=

# --- Database (RDS) ---
# RDS endpoint hostname only, no port, e.g. mydb.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_SERVER_HOST=
DB_SERVER_USER=
# Secret: from SSM Parameter Store (SecureString)
DB_SERVER_PASSWORD=
DB_SERVER_DATABASE=

# --- JWT (secret: from SSM Parameter Store). Must be identical on every instance. ---
JWT_SECRET_KEY_ACCESS_TOKEN=
JWT_SECRET_KEY_REFRESH_TOKEN=

# --- Instance identity for /api/health (from IMDSv2; optional) ---
INSTANCE_ID=
AVAILABILITY_ZONE=
